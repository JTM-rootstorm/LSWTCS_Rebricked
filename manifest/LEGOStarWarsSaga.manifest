# recomp_lift manifest for LEGOStarWarsSaga.exe, Steam (app 32440),
# unpacked with tools/unpack_steamstub.py (see FINDINGS.md). Line based:
#
#   entry <hexva> [name]   extra function entry point
#   name  <hexva> <name>   name a function (comments in generated code)
#   probe <hexva> [name]   call recomp::Probe() on entry (runtime logs it)
#   resume <hexva>         this call/jmp abandons the current call chain
#                          (SEH, longjmp): throw GuestResume to the owning
#                          frame
#   setjmp <hexva> [name]  a setjmp function: its callers catch
#                          GuestResume, its return points become entries
#   replace <hexva> [name] src/ defines f_<VA>; the lifted body becomes
#                          f_<VA>_lifted

# SEH, MSVC 8 CRT: __except_handler4 hands the __except block to
# _EH4_TransferToHandler, which sets ebp to the frame's and ends in
# `jmp esi` (the block starts by restoring esp itself).
name   006EDBE0 __except_handler4
name   006F5E51 _EH4_TransferToHandler
resume 006F5E68

# C++ exceptions: after a catch funclet returns the continuation address,
# _JumpToContinuation unlinks the SEH record, restores ebp/esp of the
# catching frame and ends in `jmp eax`.
name   006EA0CC _JumpToContinuation
resume 006EA0F5

# __tmainCRTStartup calls it with hInstance 0x400000, 0, the command
# line and nShowCmd.
name  006DE0E0 WinMain
probe 006DE0E0 WinMain

# levels\levels.txt parser; src/level_warp.cpp (LSWTCS_LEVEL test hook).
replace 005788F0
